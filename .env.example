# ============================================================================
# xxsj-fs-ob 配置模板
# 使用方法：复制本文件为 .env，按注释填写。值一律使用你自己的占位内容。
# 标注「必填」的项不填会导致 Worker 无法启动或无法处理任务。
# ============================================================================

# ----------------------------------------------------------------------------
# 飞书多维表格（必填）
# ----------------------------------------------------------------------------
# 多维表格的 Base token（从表格 URL 中获取）
FEISHU_BASE_TOKEN=<填你自己的飞书 Base token>
# 数据表 table id
FEISHU_TABLE_ID=<填你自己的数据表 table id>
# lark-cli 的 profile 名称（该 profile 需已授权可访问上面的多维表格）
LARK_PROFILE=<填你自己的 lark-cli profile 名>
# 调用 lark-cli 的身份：bot（默认）或 user
LARK_IDENTITY=bot
# lark-cli 可执行文件；已在 PATH 中时保持默认即可
LARK_CLI_BIN=lark-cli

# ----------------------------------------------------------------------------
# Obsidian 笔记库（必填）
# ----------------------------------------------------------------------------
# Obsidian vault 的绝对路径。未填写时 Worker 会启动失败并给出提示。
OBSIDIAN_VAULT_PATH=<你的 Obsidian vault 绝对路径，例如 D:\Obsidian\MyVault>
# vault 内的收件箱目录，笔记按平台写入其下子目录
OBSIDIAN_INBOX_DIR=000-Inbox\001-信息中心
# 平台名到子目录名的映射（JSON）
OBSIDIAN_PLATFORM_DIR_MAP={"抖音":"抖音","B站":"B站","微信公众号":"公众号","X":"推特","YouTube":"YouTube"}

# ----------------------------------------------------------------------------
# AI 分析（必填，用于生成摘要/要点/分类）
# ----------------------------------------------------------------------------
# mock=不调用模型；openai=调用 OpenAI 兼容接口（DeepSeek 等）
SUMMARY_MODE=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=<填你自己的分析模型 API Key>
LLM_MODEL=deepseek-chat
# 可选备用模型配置（不填则使用上面的 LLM_*）
AGNES_BASE_URL=
AGNES_API_KEY=
AGNES_MODEL=

# ----------------------------------------------------------------------------
# 语音转写（可选：不配置 Qwen Key 时会使用本地 faster-whisper）
# ----------------------------------------------------------------------------
# 阿里云百炼（DashScope）API Key，用于 Qwen-ASR 云端转录
DASHSCOPE_API_KEY=<可选：填你自己的 DashScope Key>
QWEN_ASR_MODEL=qwen3-asr-flash-filetrans
QWEN_ASR_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
# qwen-primary=先云端后本地；large-v3-only=只用本地
ASR_MODE=qwen-primary
ASR_MAX_RETRIES=2
ASR_HOTWORDS=Skill,Agent,MCP,API,Codex,Claude,ComfyUI,Obsidian,飞书,知识库

# 本地 faster-whisper 兜底（需要 Python 虚拟环境）
TRANSCRIBE_PYTHON_PATH=.venv/Scripts/python.exe
TRANSCRIBE_LANGUAGE=zh
WHISPER_SCRIPT_PATH=scripts/transcribe-faster-whisper.py
WHISPER_MODEL=large-v3
# 有 NVIDIA GPU 时用 cuda/float16；仅 CPU 时改为 cpu/int8
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# ----------------------------------------------------------------------------
# 浏览器与 Worker 基础行为（一般无需修改）
# ----------------------------------------------------------------------------
# 抖音登录态持久化目录（首次运行 scripts/manual-login.ts 扫码登录）
BROWSER_USER_DATA_DIR=.browser/douyin
# 视频浏览器目录（不填则复用 BROWSER_USER_DATA_DIR）
VIDEO_BROWSER_USER_DATA_DIR=
# 浏览器是否无头运行（抖音登录态建议 false）
HEADLESS=false
# 抖音窗口移出屏幕，避免打断工作
DOUYIN_OFFSCREEN=true
# 视频深度处理开关
VIDEO_DEEP_PROCESSING=true
# 轮询间隔（毫秒）
POLL_INTERVAL_MS=5000

# 以下为旧版收件箱监听配置，当前 Worker 不再使用，一般无需修改
DOUYIN_INBOX_URL=https://www.douyin.com
DOUYIN_MESSAGE_SELECTOR='[data-e2e="msg-item-content"]:has([class*="MessageItemShareAwemecontainer"])'
DOUYIN_OPEN_MESSAGE_TEXT=消息
DOUYIN_OPEN_CHAT_TEXT=
DOUYIN_IGNORE_EXISTING_ON_START=true

# ----------------------------------------------------------------------------
# 代理（可选）
# 留空 = 不使用代理。
# 抖音、微信公众号、B站、飞书一般无需代理；X、YouTube 通常需要。
# 启动脚本会依次读取：进程环境 → XXSJ_* → HTTPS_PROXY/HTTP_PROXY。
# ----------------------------------------------------------------------------
XXSJ_HTTPS_PROXY=
XXSJ_HTTP_PROXY=
# 也可以使用标准变量名；优先级低于上面的 XXSJ_*，留空 = 不读取
HTTPS_PROXY=
HTTP_PROXY=

# ----------------------------------------------------------------------------
# yt-dlp（仅 YouTube 需要；一般无需修改）
# ----------------------------------------------------------------------------
# yt-dlp 可执行文件路径
YTDLP_PATH=.venv/Scripts/yt-dlp.exe
# yt-dlp 专用代理；留空时依次回退 XXSJ_HTTPS_PROXY / HTTPS_PROXY；全部留空 = 不走代理
YTDLP_PROXY=
# 请求间隔限速，降低被 YouTube 限流的概率
YTDLP_SLEEP_REQUESTS=3
YTDLP_SLEEP_INTERVAL=2
YTDLP_MAX_RETRIES=3
YTDLP_RETRY_BASE_MS=20000
# 字幕语言优先级
YTDLP_LANGUAGE_PREFERENCE=zh-Hans,zh-Hant,zh-CN,zh-TW,zh,en
# 可选：yt-dlp 解决签名挑战所需的 JS runtime 与组件
YTDLP_JS_RUNTIMES=deno
YTDLP_REMOTE_COMPONENTS=ejs:github
# 可选：受限视频的 cookie 文件（公开视频不需要）
YTDLP_COOKIES=
# 无字幕视频走音频下载时的更保守限速
YTDLP_MEDIA_SLEEP_REQUESTS=1
YTDLP_MEDIA_SLEEP_INTERVAL=5

# ----------------------------------------------------------------------------
# 调试（可选）
# ----------------------------------------------------------------------------
DEBUG_ASR_COMPARISON=0

# ----------------------------------------------------------------------------
# 旧版脚本专用（当前 Worker 不使用）
# ----------------------------------------------------------------------------
FEISHU_TOKEN_FILE=
FEISHU_TOKEN_VALUE=
# 旧版转写脚本参数；当前 Worker 使用上面的 WHISPER_* 配置
TRANSCRIBE_SCRIPT_PATH=scripts/transcribe-whisper.py
TRANSCRIBE_MODEL=base
TRANSCRIBE_COMPUTE_TYPE=
