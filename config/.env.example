# 飞书 Base 配置
FEISHU_BASE_TOKEN=REPLACE_WITH_YOUR_BASE_TOKEN
FEISHU_TABLE_ID=REPLACE_WITH_YOUR_TABLE_ID

# Qwen-ASR (DashScope)
DASHSCOPE_API_KEY=REPLACE_WITH_YOUR_DASHSCOPE_KEY
QWEN_ASR_MODEL=qwen3-asr-flash-filetrans

# DeepSeek (OpenAI-compatible)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_KEY
LLM_MODEL=deepseek-chat

# Faster-Whisper Large-v3 (本地 fallback)
TRANSCRIBE_PYTHON_PATH=.venv/Scripts/python.exe
TRANSCRIBE_SCRIPT_PATH=scripts/transcribe-whisper.py
TRANSCRIBE_MODEL=large-v3

# Obsidian
OBSIDIAN_INBOX_DIR=000-Inbox/001-信息中心
OBSIDIAN_PLATFORM_DIR_MAP={"抖音":"抖音","B站":"B站","小红书":"小红书","推特":"推特","YouTube":"YouTube","公众号":"公众号"}

# Worker
ASR_MODE=qwen-primary
ASR_HOTWORDS=Skill,Agent,MCP,API,Codex,Claude,ComfyUI,Obsidian
ASR_MAX_RETRIES=2

# 日志与缓存
LOG_DIR=data/logs
LOG_RETENTION_DAYS=7
CACHE_DIR=data/tasks
CLEANUP_DRY_RUN_ONLY=true

# lark-cli profile name
LARK_PROFILE=<YOUR_LARK_PROFILE_NAME>
